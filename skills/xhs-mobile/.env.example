# xhs-mobile skill · 出图环境模板
# 拷贝为 .env 并填入真实 key（用户级放 ~/.xhs-mobile/.env，项目级放 .xhs-mobile/.env）。
# 不要把真实 key 提交到 git。

# === 出图（OpenAI 兼容）===
# 必填（--dry-run 除外）
XHS_IMAGE_API_KEY=replace_with_your_key

# 官方 OpenAI：
XHS_IMAGE_BASE_URL=https://api.openai.com/v1
# 中转/代理示例：
# XHS_IMAGE_BASE_URL=https://your-relay.example.com/v1

# 模型：官方默认 gpt-image-1；中转请改成中转支持的图像模型名
XHS_IMAGE_MODEL=gpt-image-1

# 尺寸：竖版卡片默认 1024x1536；方图 1024x1024
XHS_IMAGE_SIZE=1024x1536

# 脚本默认值，除非你的 provider 要求不同，否则保持
XHS_IMAGE_QUALITY=high
XHS_IMAGE_TIMEOUT=120
XHS_IMAGE_RETRIES=2

# 网关额外 header（JSON），例如 {"X-Relay-Project":"xhs-mobile"}
XHS_IMAGE_EXTRA_HEADERS={}

# 网关额外 body 字段（JSON），例如 {"response_format":"b64_json"}
XHS_IMAGE_EXTRA_PAYLOAD={}

# === Android 构建（可选，脚本会自动兜底）===
# 不设则按 ANDROID_HOME/ANDROID_SDK_ROOT → ~/Library/Android/sdk 顺序解析
# ANDROID_HOME=/Users/yourname/Library/Android/sdk
# 指定 android 工程目录（全局安装时若与 skill 不在同目录需设置）
# XHS_ANDROID_DIR=/path/to/xhs-mobile-skills/android
